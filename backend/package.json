{
  "name": "master-pizza-api",
  "version": "2.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-direct.js migrate deploy",
    "prisma:status": "node scripts/prisma-direct.js migrate status",
    "seed": "node prisma/seed.js",
    "setup": "prisma generate && node scripts/prisma-direct.js migrate deploy && node prisma/seed.js",
    "dev:fast": "node --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
