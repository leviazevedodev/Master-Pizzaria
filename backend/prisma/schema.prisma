generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  SCHEDULED
  RECEIVED
  PREPARING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  READY_FOR_TABLE
  SERVED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  MACHINE_PIX
  CASH
  DEBIT
  CREDIT
  BANESE_DEBIT
  PIX
  CARD
  CUSTOM
}

enum PaymentStatus {
  PENDING
  APPROVED
  CASH_PENDING
  REJECTED
  CANCELED
  REFUNDED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum TableSessionStatus {
  OPEN
  CLOSED
  CANCELED
}

enum DeliveryPricingMode {
  AREA
  DISTANCE
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?              @unique
  passwordHash        String
  sessionVersion      Int                  @default(0)
  isAdmin             Boolean              @default(false)
  adminPermissions    Json?
  staffRole           String?
  staffActive         Boolean              @default(true)
  postalCode          String?
  street              String?
  addressNumber       String?
  complement          String?
  neighborhood        String?
  city                String?
  state               String?
  referencePoint      String?
  adminNote           String?
  customerBlocked     Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  birthday            DateTime?
  birthdayBenefitYear Int?
  loyaltyPoints       Int                  @default(0)
  cashbackBalance     Decimal              @default(0) @db.Decimal(10, 2)
  inviteCode          String?              @unique
  referredByUserId    String?
  twoFactorEnabled    Boolean              @default(false)
  twoFactorSecret     String?
  marketingOptIn      Boolean              @default(false)
  orders              Order[]
  resetTokens         PasswordResetToken[]
  media               MediaAsset[]
  favoriteAddresses   CustomerAddress[]
  productFavorites    ProductFavorite[]
  rewardTransactions  RewardTransaction[]
  courierOrders       Order[]              @relation("CourierOrders")
  referredByUser      User?                @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("UserReferrals")

  @@index([createdAt])
  @@index([isAdmin, lastLoginAt, updatedAt])
  @@index([referredByUserId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([createdAt])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  products      Product[]
  subcategories Subcategory[]
  flavorGroups  FlavorGroup[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active, sortOrder])
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, active, sortOrder])
}

model FlavorGroup {
  id          String                     @id @default(cuid())
  name        String
  slug        String
  description String?
  categoryId  String
  active      Boolean                    @default(true)
  sortOrder   Int                        @default(0)
  category    Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  flavors     Flavor[]
  comboRules  ComboSlotFlavorGroupRule[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, active, sortOrder])
}

model Flavor {
  id                String                @id @default(cuid())
  name              String                @unique
  slug              String                @unique
  description       String                @default("")
  ingredients       Json                  @default("[]")
  groupId           String?
  sourceProductId   String?               @unique
  price             Decimal               @db.Decimal(10, 2)
  promoPrice        Decimal?              @db.Decimal(10, 2)
  promoActive       Boolean               @default(false)
  promoStartAt      DateTime?
  promoEndAt        DateTime?
  image             String?
  active            Boolean               @default(true)
  featured          Boolean               @default(false)
  allowHalfAndHalf  Boolean               @default(true)
  sortOrder         Int                   @default(0)
  stockTracked      Boolean               @default(false)
  stockQuantity     Int                   @default(0)
  stockLowThreshold Int                   @default(5)
  group             FlavorGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sourceProduct     Product?              @relation("FlavorSourceProduct", fields: [sourceProductId], references: [id], onDelete: SetNull)
  sizes             FlavorSize[]
  products          ProductFlavor[]
  comboRules        ComboSlotFlavorRule[]
  orderItems        OrderItemFlavor[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([active, sortOrder])
  @@index([groupId, active, sortOrder])
}

model Product {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  description          String
  price                Decimal                    @db.Decimal(10, 2)
  image                String?
  badge                String?
  featured             Boolean                    @default(false)
  isNew                Boolean                    @default(false)
  available            Boolean                    @default(true)
  sortOrder            Int                        @default(0)
  allowFlavorSplit     Boolean                    @default(false)
  isFlavorOption       Boolean                    @default(false)
  isCombo              Boolean                    @default(false)
  maxFlavors           Int                        @default(1)
  flavorPricingMode    String                     @default("MAX")
  stockTracked         Boolean                    @default(false)
  stockQuantity        Int                        @default(0)
  stockLowThreshold    Int                        @default(5)
  costPrice            Decimal                    @default(0) @db.Decimal(10, 2)
  pausedUntil          DateTime?
  availableDays        Json?
  availableStartTime   String?
  availableEndTime     String?
  removableIngredients Json?
  deletedAt            DateTime?
  categoryId           String
  category             Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId        String?
  subcategory          Subcategory?               @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  productFlavors       ProductFlavor[]
  modifierGroups       ProductModifierGroup[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  items                OrderItem[]
  legacyOrderFlavors   OrderItemFlavor[]          @relation("LegacyProductFlavor")
  promotion            Promotion?
  recipeItems          ProductInventoryItem[]
  productSizes         ProductSize[]
  comboItems           ComboItem[]                @relation("ComboProduct")
  includedInCombos     ComboItem[]                @relation("ComboComponent")
  comboSlots           ComboSlot[]                @relation("ComboSlots")
  comboSlotTemplates   ComboSlot[]                @relation("ComboSlotBaseProduct")
  comboSlotChoices     ComboSlotProduct[]
  centralFlavor        Flavor?                    @relation("FlavorSourceProduct")
  favorites            ProductFavorite[]
  compreSemFilaLinks   CompreSemFilaProductLink[]

  @@index([categoryId, available, deletedAt])
  @@index([subcategoryId, available])
  @@index([featured, available])
  @@index([sortOrder])
}

model ComboItem {
  comboId   String
  productId String
  quantity  Int        @default(1)
  sortOrder Int        @default(0)
  sizeId    String?
  size      PizzaSize? @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  combo     Product    @relation("ComboProduct", fields: [comboId], references: [id], onDelete: Cascade)
  product   Product    @relation("ComboComponent", fields: [productId], references: [id], onDelete: Restrict)

  @@id([comboId, productId])
  @@index([productId])
  @@index([sizeId])
  @@index([comboId, sortOrder])
}

model ComboSlot {
  id                  String                     @id @default(cuid())
  comboId             String
  type                String                     @default("FIXED_PRODUCT")
  name                String                     @default("")
  quantity            Int                        @default(1)
  sortOrder           Int                        @default(0)
  baseProductId       String?
  sizeId              String?
  flavorScope         String                     @default("ALL")
  maxFlavors          Int?
  allowModifiers      Boolean                    @default(false)
  modifierPricingMode String                     @default("NORMAL")
  combo               Product                    @relation("ComboSlots", fields: [comboId], references: [id], onDelete: Cascade)
  baseProduct         Product?                   @relation("ComboSlotBaseProduct", fields: [baseProductId], references: [id], onDelete: Restrict)
  size                PizzaSize?                 @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  products            ComboSlotProduct[]
  flavorGroupRules    ComboSlotFlavorGroupRule[]
  flavorRules         ComboSlotFlavorRule[]
  modifierRules       ComboSlotModifierRule[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([comboId, sortOrder])
  @@index([baseProductId])
  @@index([sizeId])
}

model ComboSlotProduct {
  id              String     @id @default(cuid())
  slotId          String
  productId       String
  sizeId          String?
  priceAdjustment Decimal    @default(0) @db.Decimal(10, 2)
  sortOrder       Int        @default(0)
  slot            ComboSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  size            PizzaSize? @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@index([slotId, sortOrder])
  @@index([productId])
  @@index([sizeId])
}

model ComboSlotFlavorGroupRule {
  slotId        String
  flavorGroupId String
  pricingRule   String      @default("INCLUDED")
  amount        Decimal     @default(0) @db.Decimal(10, 2)
  slot          ComboSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  flavorGroup   FlavorGroup @relation(fields: [flavorGroupId], references: [id], onDelete: Restrict)

  @@id([slotId, flavorGroupId])
  @@index([flavorGroupId])
}

model ComboSlotFlavorRule {
  slotId      String
  flavorId    String
  pricingRule String    @default("INCLUDED")
  amount      Decimal   @default(0) @db.Decimal(10, 2)
  slot        ComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  flavor      Flavor    @relation(fields: [flavorId], references: [id], onDelete: Restrict)

  @@id([slotId, flavorId])
  @@index([flavorId])
}

model ComboSlotModifierRule {
  slotId      String
  optionId    String
  pricingRule String         @default("NORMAL")
  amount      Decimal        @default(0) @db.Decimal(10, 2)
  slot        ComboSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  option      ModifierOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([slotId, optionId])
  @@index([optionId])
}

model PizzaSize {
  id                 String                     @id @default(cuid())
  name               String                     @unique
  slug               String                     @unique
  diameterCm         Int?
  maxFlavors         Int                        @default(4)
  sortOrder          Int                        @default(0)
  active             Boolean                    @default(true)
  products           ProductSize[]
  flavors            FlavorSize[]
  comboItems         ComboItem[]
  comboSlots         ComboSlot[]
  comboSlotProducts  ComboSlotProduct[]
  orderItems         OrderItem[]
  compreSemFilaLinks CompreSemFilaProductLink[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([active, sortOrder])
}

model FlavorSize {
  flavorId    String
  sizeId      String
  pricingMode String    @default("FIXED")
  price       Decimal   @default(0) @db.Decimal(10, 2)
  available   Boolean   @default(true)
  sortOrder   Int       @default(0)
  flavor      Flavor    @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  size        PizzaSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([flavorId, sizeId])
  @@index([sizeId, available])
  @@index([flavorId, available])
}

model ProductSize {
  productId String
  sizeId    String
  price     Decimal   @db.Decimal(10, 2)
  sortOrder Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      PizzaSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([productId, sizeId])
  @@index([sizeId])
  @@index([productId, sortOrder])
}

model Promotion {
  id            String    @id @default(cuid())
  title         String
  subtitle      String?
  image         String?
  originalPrice Decimal   @db.Decimal(10, 2)
  promoPrice    Decimal   @db.Decimal(10, 2)
  sizePrices    Json?
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  startAt       DateTime?
  endAt         DateTime?
  productId     String    @unique
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, sortOrder])
}

model ProductFlavor {
  productId String
  flavorId  String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavor    Flavor  @relation(fields: [flavorId], references: [id], onDelete: Cascade)

  @@id([productId, flavorId])
  @@index([flavorId])
  @@index([productId, sortOrder])
}

model ModifierGroup {
  id          String                 @id @default(cuid())
  name        String                 @unique
  description String?
  required    Boolean                @default(false)
  minSelect   Int                    @default(0)
  maxSelect   Int                    @default(1)
  active      Boolean                @default(true)
  sortOrder   Int                    @default(0)
  options     ModifierOption[]
  products    ProductModifierGroup[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([active, sortOrder])
}

model ModifierOption {
  id                String                  @id @default(cuid())
  groupId           String
  name              String
  description       String?
  price             Decimal                 @default(0) @db.Decimal(10, 2)
  promoPrice        Decimal?                @db.Decimal(10, 2)
  promoActive       Boolean                 @default(false)
  promoStartAt      DateTime?
  promoEndAt        DateTime?
  image             String?
  active            Boolean                 @default(true)
  sortOrder         Int                     @default(0)
  stockTracked      Boolean                 @default(false)
  stockQuantity     Int                     @default(0)
  stockLowThreshold Int                     @default(5)
  group             ModifierGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItems        OrderItemOption[]
  comboRules        ComboSlotModifierRule[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([groupId, name])
  @@index([groupId, active, sortOrder])
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
  @@index([productId, sortOrder])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model DeliveryArea {
  id                    String   @id @default(cuid())
  city                  String   @default("São Cristóvão - SE")
  neighborhood          String
  fee                   Decimal  @db.Decimal(10, 2)
  distanceKm            Decimal? @db.Decimal(10, 2)
  minimumOrder          Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  orders                Order[]

  @@unique([city, neighborhood])
  @@index([active, sortOrder])
}

model StoreHour {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  label     String
  openTime  String   @default("18:00")
  closeTime String   @default("23:00")
  closed    Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model RestaurantTable {
  id        String         @id @default(cuid())
  number    Int            @unique
  name      String?
  seats     Int            @default(4)
  location  String?
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  TableSession[]
  orders    Order[]

  @@index([active, sortOrder])
}

model TableSession {
  id                 String             @id @default(cuid())
  tableId            String
  table              RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Restrict)
  openKey            String?            @unique
  status             TableSessionStatus @default(OPEN)
  customerName       String?
  guestCount         Int?
  notes              String?
  openedById         String?
  openedByName       String
  closedById         String?
  closedByName       String?
  paymentMethod      PaymentMethod?
  paymentMethodLabel String?
  subtotal           Decimal            @default(0) @db.Decimal(10, 2)
  total              Decimal            @default(0) @db.Decimal(10, 2)
  amountPaid         Decimal?           @db.Decimal(10, 2)
  changeAmount       Decimal?           @db.Decimal(10, 2)
  openedAt           DateTime           @default(now())
  closedAt           DateTime?
  updatedAt          DateTime           @updatedAt
  orders             Order[]

  @@index([tableId, status, openedAt])
  @@index([openedById, status])
  @@index([status, closedAt])
}

model Order {
  id                     String               @id @default(cuid())
  trackingCode           String               @unique @default(uuid())
  customerName           String
  customerPhone          String
  fulfillmentType        FulfillmentType      @default(DELIVERY)
  postalCode             String?
  street                 String?
  addressNumber          String?
  complement             String?
  neighborhood           String?
  city                   String?
  state                  String?
  latitude               Decimal?             @db.Decimal(10, 7)
  longitude              Decimal?             @db.Decimal(10, 7)
  distanceKm             Decimal?             @db.Decimal(10, 2)
  deliveryAreaId         String?
  deliveryArea           DeliveryArea?        @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  notes                  String?
  referencePoint         String?
  subtotal               Decimal              @db.Decimal(10, 2)
  deliveryFee            Decimal              @db.Decimal(10, 2)
  total                  Decimal              @db.Decimal(10, 2)
  discountAmount         Decimal              @default(0) @db.Decimal(10, 2)
  couponCode             String?
  cashbackUsed           Decimal              @default(0) @db.Decimal(10, 2)
  cashbackEarned         Decimal              @default(0) @db.Decimal(10, 2)
  orderOrigin            String               @default("SITE")
  tableId                String?
  table                  RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSessionId         String?
  tableSession           TableSession?        @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  createdByStaffId       String?
  createdByStaffName     String?
  readyAt                DateTime?
  outForDeliveryAt       DateTime?
  deliveredAt            DateTime?
  rewardsProcessedAt     DateTime?
  birthdayBenefitApplied Boolean              @default(false)
  paymentMethod          PaymentMethod
  paymentMethodLabel     String?
  paymentStatus          PaymentStatus        @default(CASH_PENDING)
  paymentProvider        String?
  paymentExternalId      String?
  paymentPreferenceId    String?
  paymentUrl             String?
  paidAt                 DateTime?
  scheduledAt            DateTime?
  acceptedAt             DateTime?
  estimatedDeliveryMin   Int                  @default(30)
  estimatedDeliveryMax   Int                  @default(45)
  changeFor              Decimal?             @db.Decimal(10, 2)
  status                 OrderStatus          @default(RECEIVED)
  cancelReason           String?
  stockApplied           Boolean              @default(false)
  stockSnapshot          Json?
  assignedCourierId      String?
  assignedCourier        User?                @relation("CourierOrders", fields: [assignedCourierId], references: [id], onDelete: SetNull)
  printedAt              DateTime?
  kitchenSeenAt          DateTime?
  userId                 String?
  user                   User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  items                  OrderItem[]
  history                OrderStatusHistory[]
  review                 Review?
  rewardTransactions     RewardTransaction[]
  compreSemFilaOrder     CompreSemFilaOrder?

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([scheduledAt])
  @@index([customerPhone])
  @@index([userId, createdAt])
  @@index([deliveryAreaId])
  @@index([assignedCourierId, status])
  @@index([tableId, status])
  @@index([tableSessionId, status])
  @@index([createdAt])
}

model OrderItem {
  id             String            @id @default(cuid())
  orderId        String
  productId      String
  name           String
  quantity       Int
  unitPrice      Decimal           @db.Decimal(10, 2)
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  notes          String?
  sizeId         String?
  sizeName       String?
  comboItems     Json?
  sizePrice      Decimal?          @db.Decimal(10, 2)
  priceBreakdown Json?
  size           PizzaSize?        @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  flavors        OrderItemFlavor[]
  options        OrderItemOption[]

  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
}

model OrderItemFlavor {
  id          String    @id @default(cuid())
  orderItemId String
  flavorId    String?
  productId   String?
  name        String
  unitPrice   Decimal   @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavor      Flavor?   @relation(fields: [flavorId], references: [id], onDelete: SetNull)
  product     Product?  @relation("LegacyProductFlavor", fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([flavorId])
  @@index([productId])
}

model OrderItemOption {
  id          String          @id @default(cuid())
  orderItemId String
  optionId    String?
  groupName   String
  optionName  String
  unitPrice   Decimal         @default(0) @db.Decimal(10, 2)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option      ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedByUserId String?
  changedByName   String?
  changedByRole   String?
  createdAt       DateTime    @default(now())
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([changedByUserId, status, createdAt])
  @@index([status, createdAt])
}

model DeliveryGeoCache {
  id              String   @id @default(cuid())
  city            String
  cityKey         String
  state           String   @default("")
  stateKey        String   @default("")
  neighborhood    String
  neighborhoodKey String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  distanceKm      Decimal  @db.Decimal(10, 2)
  source          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cityKey, stateKey, neighborhoodKey])
  @@index([updatedAt])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  userId         String
  label          String   @default("Favorito")
  postalCode     String
  street         String
  addressNumber  String
  complement     String?
  neighborhood   String
  city           String
  state          String
  referencePoint String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([updatedAt])
}

model InventoryItem {
  id          String                 @id @default(cuid())
  name        String                 @unique
  unit        String                 @default("un")
  quantity    Decimal                @default(0) @db.Decimal(12, 3)
  minQuantity Decimal                @default(0) @db.Decimal(12, 3)
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  recipes     ProductInventoryItem[]
  movements   InventoryMovement[]

  @@index([active, name])
}

model ProductInventoryItem {
  productId       String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 3)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([productId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryMovement {
  id              String         @id @default(cuid())
  inventoryItemId String?
  productId       String?
  orderId         String?
  type            String
  quantity        Decimal        @db.Decimal(12, 3)
  note            String?
  createdAt       DateTime       @default(now())
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([orderId])
}

model DeliverySurchargeRule {
  id        String   @id @default(cuid())
  name      String
  dayOfWeek Int?
  startTime String
  endTime   String
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, dayOfWeek])
}

model WhatsAppOutbox {
  id               String    @id @default(cuid())
  orderId          String?
  customerPhone    String
  event            String
  message          String
  status           String    @default("PENDING")
  providerResponse String?
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

