model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  type             String    @default("PERCENT")
  value            Decimal   @db.Decimal(10, 2)
  minimumOrder     Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscount      Decimal?  @db.Decimal(10, 2)
  maxUses          Int?
  uses             Int       @default(0)
  perCustomerLimit Int       @default(1)
  allowGuest       Boolean   @default(false)
  active           Boolean   @default(true)
  startAt          DateTime?
  endAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active, startAt, endAt])
}

model Review {
  id             String    @id @default(cuid())
  orderId        String?   @unique
  customerName   String?
  rating         Int
  foodRating     Int?
  deliveryRating Int?
  comment        String?
  status         String    @default("PENDING")
  approvedAt     DateTime?
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId, createdAt])
}

model RewardTransaction {
  id          String   @id @default(cuid())
  externalKey String   @unique
  userId      String
  orderId     String?
  type        String
  points      Int      @default(0)
  amount      Decimal  @default(0) @db.Decimal(10, 2)
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId, type])
}

model AdminLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  role      String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model TechnicalLog {
  id        String   @id @default(cuid())
  level     String   @default("ERROR")
  event     String
  message   String
  requestId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
}

model CompreSemFilaProductLink {
  id            Int        @id @default(autoincrement())
  variantKey    String     @unique
  productId     String
  sizeId        String?
  csfProductId  Int?       @unique
  barcode       String?    @unique
  enabled       Boolean    @default(true)
  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          PizzaSize? @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([sizeId])
  @@index([enabled, lastSyncedAt])
}

model CompreSemFilaOrder {
  id            String    @id @default(cuid())
  csfOrderId    Int       @unique
  orderId       String?   @unique
  csfStatus     String
  mappingStatus String    @default("PENDING")
  payload       Json?
  lastPulledAt  DateTime?
  lastPushedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([mappingStatus, updatedAt])
  @@index([csfStatus, updatedAt])
}

model CompreSemFilaSyncRun {
  id          String    @id @default(cuid())
  kind        String
  status      String    @default("RUNNING")
  source      String    @default("MANUAL")
  processed   Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  details     Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([kind, startedAt])
  @@index([status, startedAt])
}

model TableClosureRecord {
  id                 String             @id @default(cuid())
  sourceSessionId    String             @unique
  tableId            String
  tableNumber        Int
  tableName          String?
  customerName       String?
  status             TableSessionStatus
  paymentMethod      PaymentMethod?
  paymentMethodLabel String?
  subtotal           Decimal            @default(0) @db.Decimal(10, 2)
  total              Decimal            @default(0) @db.Decimal(10, 2)
  amountPaid         Decimal?           @db.Decimal(10, 2)
  changeAmount       Decimal?           @db.Decimal(10, 2)
  openedById         String?
  openedByName       String
  closedById         String?
  closedByName       String?
  openedAt           DateTime
  closedAt           DateTime
  createdAt          DateTime           @default(now())

  @@index([closedAt])
  @@index([tableId, closedAt])
}

model CashSession {
  id            String    @id @default(cuid())
  userId        String
  openKey       String?   @unique
  userName      String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingAmount Decimal   @default(0) @db.Decimal(10, 2)
  closingAmount Decimal?  @db.Decimal(10, 2)
  notes         String?

  @@index([userId, openedAt])
  @@index([closedAt])
}

model BusinessGoal {
  id        String   @id @default(cuid())
  name      String
  metric    String   @default("REVENUE")
  period    String   @default("CUSTOM")
  target    Decimal  @db.Decimal(12, 2)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, startsAt, endsAt])
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  segment     String
  message     String
  title       String?
  description String?
  image       String?
  buttonText  String?
  targetUrl   String?
  couponCode  String?
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, startsAt, endsAt, sortOrder])
}
