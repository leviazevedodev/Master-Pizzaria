POSTGRES_DB=master_pizza
POSTGRES_USER=master
POSTGRES_PASSWORD=troque-esta-senha-longa-e-unica
# Runtime da aplicação. No Neon, pode ser a URL com "-pooler".
DATABASE_URL=postgresql://master:troque-esta-senha-longa-e-unica@db:5432/master_pizza?schema=public
# Operações Prisma de schema/migration. No Neon, cole a URL DIRETA fornecida pelo painel
# (sem "-pooler"). Não tente montar o hostname manualmente.
# Em PostgreSQL local, use exatamente a mesma URL da DATABASE_URL.
DIRECT_URL=postgresql://master:troque-esta-senha-longa-e-unica@db:5432/master_pizza?schema=public
JWT_SECRET=gere-ao-menos-32-caracteres-aleatorios
# Para testar com Docker local. Em producao, troque pela URL HTTPS real.
PUBLIC_SITE_URL=http://localhost:5173

# Pagamento online (configure os dois valores para habilitar)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Recuperação de senha por e-mail
RESEND_API_KEY=
EMAIL_FROM="Master Pizza <contato@pizza.exemplo.com>"

# Integrações opcionais
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
NOMINATIM_EMAIL=

# Somente para o seed inicial executado manualmente
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@pizza.exemplo.com
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROTATE_PASSWORD=false
# Proteções para bancos que já possuem dados; deixe ambas em false normalmente.
ADMIN_SEED_PROMOTE_EXISTING=false
SEED_FORCE_DEFAULTS=false
