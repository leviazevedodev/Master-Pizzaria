POSTGRES_DB=master_pizza
POSTGRES_USER=master
POSTGRES_PASSWORD=troque-esta-senha-longa-e-unica
# Runtime da aplicação. No Neon, pode ser a URL com "-pooler".
DATABASE_URL=postgresql://master:troque-esta-senha-longa-e-unica@db:5432/master_pizza?schema=public
# Operações Prisma de schema/migration. No Neon, cole a URL DIRETA fornecida pelo painel
# (sem "-pooler"). Não tente montar o hostname manualmente.
# Em PostgreSQL local, use exatamente a mesma URL da DATABASE_URL.
DIRECT_URL=postgresql://master:troque-esta-senha-longa-e-unica@db:5432/master_pizza?schema=public
JWT_SECRET=gere-ao-menos-32-caracteres-aleatorios
# Para testar com Docker local. Em producao, troque pela URL HTTPS real.
PUBLIC_SITE_URL=http://localhost:5173

# Pagamento online transparente (Mercado Pago > Suas integrações > Credenciais)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta configurada no webhook de pagamentos
MERCADOPAGO_WEBHOOK_SECRET=

# Notificações Web Push (gere o par VAPID com: npx web-push generate-vapid-keys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@seudominio.com.br

# Recuperação de senha por e-mail (Resend: API key e remetente de domínio verificado)
RESEND_API_KEY=
EMAIL_FROM="Master Pizzaria <contato@seudominio.com.br>"

# Integrações opcionais
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
NOMINATIM_EMAIL=

# Compre Sem Fila. As credenciais ficam somente no backend.
CSF_ENABLED=false
CSF_STORE_ID=
CSF_API_KEY=
CSF_PRODUCT_SYNC_ENABLED=false
CSF_ORDER_SYNC_ENABLED=false
# O endpoint de produtos aceita no máximo uma sincronização a cada 20 minutos.
CSF_PRODUCT_SYNC_INTERVAL_MINUTES=20
CSF_ORDER_SYNC_INTERVAL_SECONDS=60
# O envio de log é opcional e usa o endpoint externo descrito pela CSF.
CSF_LOG_SYNC_ENABLED=false
CSF_UNLIMITED_STOCK=999

# Somente para o seed inicial executado manualmente
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@pizza.exemplo.com
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROTATE_PASSWORD=false
# Proteções para bancos que já possuem dados; deixe ambas em false normalmente.
ADMIN_SEED_PROMOTE_EXISTING=false
SEED_FORCE_DEFAULTS=false
